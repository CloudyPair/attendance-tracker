@startuml ActivityMarking
title Диаграмма активностей: отметка и правка посещаемости

|Ответственный|
start
:Открыть «Занятия на сегодня»;
:Выбрать занятие;

|Система|
if (Есть право отмечать?\n(староста / зам. / активная замена,\nстудент из этой группы)) then (нет)
  :Показать ошибку доступа;
  stop
else (да)
endif

if (Окно отметки открыто?\n(с 00:00 дня занятия\nдо 00:00 следующего дня)) then (нет)
  :Показать отметки только для чтения;
  stop
else (да)
endif

:Загрузить записи группы\n(создать отсутствующие в статусе NOT_MARKED);

|Ответственный|
:Просмотреть список группы;
if (Нужна быстрая отметка?) then (да)
  :Нажать «Все присутствуют»;
else (нет)
endif
:Скорректировать статусы\n(PRESENT / ABSENT);
:Нажать «Сохранить»;

|Система|
if (Меняется уже отмеченная запись?) then (да)
  repeat
    |Ответственный|
    :Ввести причину правки;
    |Система|
  repeat while (Причина пуста?) is (да) not (нет)
else (нет)
endif

:Начать транзакцию;
:Обновить AttendanceRecord;
:Записать AttendanceChange\n(кто, когда, старый и новый статус, причина);
if (Ошибка или конфликт\nуникальности?) then (да)
  :Откатить транзакцию;
  :Сообщить «Данные изменились, обновите страницу»;
  stop
else (нет)
  :Зафиксировать транзакцию;
endif

:Пересчитать статистику\nзатронутых студентов;
if (Уровень ухудшился\n(OK → WARNING → BELOW_THRESHOLD)?) then (да)
  :Отправить уведомление студенту в Telegram\n(если привязан);
else (нет)
endif
:Показать «Отметки сохранены»;

|Ответственный|
stop

@enduml
