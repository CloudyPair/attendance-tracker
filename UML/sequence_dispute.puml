@startuml SequenceDispute
title Последовательность: заявка с документом и решение преподавателя
autonumber
actor "Студент" as S
participant "Сайт / Telegram-бот" as Client
participant "DisputeService" as DS
participant "Веб-интерфейс" as Web
participant "AccessPolicy" as AP
participant "AttendanceService" as AS
participant "NotificationService" as NS
participant "TelegramChannel" as TC
database "БД" as DB
actor "Преподаватель предмета" as T

== Одна заявка с объяснением и документом ==
S -> Client : пропуски от новых к старым → «Оспорить»\nобъяснение, необязательный файл / фото до 5 МБ
Client -> DS : create(student, record_id, comment, attachment)
DS -> DB : проверить владельца, ABSENT, отсутствие OPEN,\nналичие активного преподавателя курса; заблокировать занятие
alt проверка не пройдена
  DS --> Client : ошибка
else
  DS -> DB : INSERT Dispute(OPEN, comment, attachment)
  DS --> Client : заявка создана
  Client --> S : «Заявка отправлена преподавателю»
end

== Просмотр и решение ==
T -> Web : «Решение споров»
Web -> DS : list_for(teacher)
DS -> DB : споры только курсов, закрепленных за преподавателем
DS --> Web : заявки и ссылки на документы
T -> Web : скачать документ
Web -> DS : attachment_for_dispute(user, dispute_id)
DS -> AP : can_view_course(teacher, course)
DS --> Web : файл при наличии права
Web --> T : приватное скачивание документа

T -> Web : исправить на «Был» / отклонить с комментарием
Web -> DS : resolve(teacher, dispute_id, fix, comment)
DS -> AP : can_resolve_dispute(teacher, dispute)
alt не преподаватель предмета
  DS --> Web : ошибка доступа
else разрешено и спор OPEN
  DS -> DB : блокировка занятия и спора
  alt исправить
    DS -> AS : correct_record(teacher, record_id, PRESENT,\n«Спор №N», DISPUTE)
    AS -> DB : UPDATE AttendanceRecord; INSERT AttendanceChange\n(changed_by = teacher.user); увеличить marking_version
    DS -> DB : FIXED, resolved_by = teacher.user
  else отклонить
    DS -> DB : REJECTED, обязательный комментарий,\nresolved_by = teacher.user
  end
  DS -> NS : notify(student, DISPUTE_RESOLVED, text)
  NS -> DB : INSERT Notification
  note over NS, DB : Доставка после commit; неудачные отправки повторяет очередь.
  NS -> TC : send(chat_id, text)
  TC --> S : результат решения
  DS --> Web : решение сохранено
end
@enduml
